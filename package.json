{
  "name": "@glowplug-studio/figcraft-react",
  "version": "0.53.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "examples/nextjs"
  ],
  "files": [
    "dist",
    "fonts",
    "NOTICE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "imports": {
    "#figcraft-font-assets": {
      "browser": "./dist/font-assets-browser.js",
      "node": "./dist/font-assets-node.js",
      "default": "./dist/font-assets-browser.js"
    },
    "#figcraft-harfbuzz": {
      "types": [
        "./src/engine/harfbuzz/index.d.mts",
        "./dist/engine/harfbuzz/index.d.mts"
      ],
      "browser": "./dist/engine/harfbuzz/browser.js",
      "node": "./dist/engine/harfbuzz/index.mjs",
      "default": "./dist/engine/harfbuzz/browser.js"
    },
    "#figcraft-icc-runtime": {
      "browser": "./dist/icc-browser.js",
      "node": "./dist/icc-node.js",
      "default": "./dist/icc-browser.js"
    },
    "#figcraft-word-segmenter": {
      "browser": "./dist/icu-browser.js",
      "node": "./dist/icu-node.js",
      "default": "./dist/icu-browser.js"
    }
  },
  "exports": {
    "./fonts.css": "./fonts/catalog.css",
    "./fonts/*.ttf": "./fonts/*.ttf",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./backends/supabase": {
      "types": "./dist/backends/supabase/index.d.ts",
      "import": "./dist/backends/supabase/index.js"
    },
    "./backends/memory": {
      "types": "./dist/backends/memory/index.d.ts",
      "import": "./dist/backends/memory/index.js"
    }
  },
  "scripts": {
    "build": "vite build && tsc -b --force && node scripts/build-text-runtime.ts",
    "playwright:install": "playwright install chromium",
    "preview:build": "npm run build && npm run build --workspace @glowplug-studio/figcraft-react-preview",
    "preview:dev": "npm run build && npm run dev --workspace @glowplug-studio/figcraft-react-preview",
    "preview:test": "npm run build && npm run dev --workspace @glowplug-studio/figcraft-react-preview -- --hostname 127.0.0.1 --port 3100",
    "typecheck": "tsc -b --force --pretty false && tsc -p tsconfig.tests.json --pretty false && npm run typecheck --workspace @glowplug-studio/figcraft-react-preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "upstream:check": "bash scripts/sync-upstream.sh --check",
    "upstream:sync": "bash scripts/sync-upstream.sh --push",
    "test:integration": "FIGCRAFT_LOCAL_INTEGRATION=1 vitest run tests/integration"
  },
  "peerDependencies": {
    "@supabase/supabase-js": ">=2.119.0 <3",
    "react": ">=18.2.0 <20",
    "react-dom": ">=18.2.0 <20"
  },
  "peerDependenciesMeta": {
    "@supabase/supabase-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@supabase/supabase-js": "2.119.0",
    "@types/node": "26.6.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "6.2.1",
    "fake-indexeddb": "6.2.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rolldown": "1.2.16",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@zip.js/zip.js": "2.24.0",
    "fflate": "0.8.3",
    "geotiff": "3.0.5",
    "image-size": "2.1.0",
    "lcms-wasm": "1.0.5",
    "lossless-json": "4.3.3",
    "paper": "0.17.0"
  }
}
