{
  "nativeRevision": "bad07e4433240cad046589129c084bd2fc36f097",
  "cases": [
    {
      "name": "a mixed selection takes the auto fallback and links to its new style",
      "steps": [
        {"command": "text.create", "params": {"text": "A\nB", "x": 0, "y": 0}},
        {"command": "node.set", "params": {"id": 2, "props": {"wrapStyle": "balance", "start": 0, "end": 0}}},
        {"command": "node.get", "params": {"id": 2}, "expected": {"wrapStyle": null, "lineWrapStyles": ["balance", "auto"], "textStyleRanges": null, "textStyle": null}},
        {"command": "text.edit.begin", "params": {"id": 2}},
        {"command": "style.create", "params": {"type": "text", "name": "Auto from mixed", "from": 2}, "expected": {"id": "S:1"}},
        {"command": "text.edit.end", "params": {}},
        {"command": "node.get", "params": {"id": 2}, "expected": {"wrapStyle": null, "lineWrapStyles": null, "textStyleRanges": [[0, 3, "S:1"]], "textStyle": "S:1"}},
        {"command": "style.list", "params": {"type": "text"}, "expected": [{"id": "S:1", "name": "Auto from mixed", "paragraph": null}]},
        {"command": "style.apply", "params": {"style": "S:1", "ids": [2], "start": 0, "end": 1}},
        {"command": "node.get", "params": {"id": 2}, "expected": {"wrapStyle": null, "lineWrapStyles": null, "textStyleRanges": [[0, 3, "S:1"]], "textStyle": "S:1"}}
      ]
    },
    {
      "name": "a mixed selection takes the layer wrap and links to its new style",
      "steps": [
        {"command": "text.create", "params": {"text": "A\nB", "x": 0, "y": 0}},
        {"command": "node.set", "params": {"id": 2, "props": {"wrapStyle": "pretty"}}},
        {"command": "node.set", "params": {"id": 2, "props": {"wrapStyle": "balance", "start": 0, "end": 0}}},
        {"command": "node.get", "params": {"id": 2}, "expected": {"wrapStyle": null, "lineWrapStyles": ["balance", "pretty"], "textStyleRanges": null, "textStyle": null}},
        {"command": "text.edit.begin", "params": {"id": 2}},
        {"command": "style.create", "params": {"type": "text", "name": "Pretty from mixed", "from": 2}, "expected": {"id": "S:1"}},
        {"command": "text.edit.end", "params": {}},
        {"command": "node.get", "params": {"id": 2}, "expected": {"wrapStyle": "pretty", "lineWrapStyles": null, "textStyleRanges": [[0, 3, "S:1"]], "textStyle": "S:1"}},
        {"command": "style.list", "params": {"type": "text"}, "expected": [{"id": "S:1", "name": "Pretty from mixed", "paragraph": {"wrap_style": "pretty"}}]}
      ]
    },
    {
      "name": "a uniform selection links the chosen characters only",
      "steps": [
        {"command": "text.create", "params": {"text": "One\nTwo", "x": 0, "y": 0}},
        {"command": "node.set", "params": {"id": 2, "props": {"wrapStyle": "balance", "start": 0, "end": 0}}},
        {"command": "text.edit.begin", "params": {"id": 2, "caret": 0}},
        {"command": "text.edit.selectWord", "params": {"index": 0}},
        {"command": "style.create", "params": {"type": "text", "name": "Balance from one", "from": 2}, "expected": {"id": "S:1"}},
        {"command": "text.edit.end", "params": {}},
        {"command": "node.get", "params": {"id": 2}, "expected": {"wrapStyle": null, "lineWrapStyles": ["balance", "auto"], "textStyleRanges": [[0, 3, "S:1"]], "textStyle": null}},
        {"command": "style.list", "params": {"type": "text"}, "expected": [{"id": "S:1", "name": "Balance from one", "paragraph": {"wrap_style": "balance"}}]}
      ]
    }
  ]
}
