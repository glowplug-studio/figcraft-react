# Browser-safe Supabase values for a local host application.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Next.js preview host.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Next.js server only. Set this privately for the online publication validator.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Optional server-side capacity overrides. Defaults match the native public host.
# FIGCRAFT_MAX_FILES=1000
# FIGCRAFT_MAX_FILES_PER_IP=20
# FIGCRAFT_MAX_MB_PER_IP=256
# FIGCRAFT_MAX_TOTAL_MB=10240
